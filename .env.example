# Copy to .env for local runs; on Coolify set these as environment variables.
# No secrets belong in this file.

GAELD_VERSION=v3.6.6

APP_ENV=production
APP_DEBUG=false
APP_URL=https://gaeld.tachly.app
APP_LOCALE=de
APP_KEY=            # base64:...  -> `php artisan key:generate --show` or `openssl rand -base64 32` prefixed with "base64:"

DB_DATABASE=gaeld
DB_USERNAME=gaeld
DB_PASSWORD=        # long random string

REDIS_PASSWORD=null

MEILI_MASTER_KEY=   # 32+ char random
SCOUT_DRIVER=meilisearch

TRUSTED_PROXIES=*
WEBAUTHN_ID=gaeld.tachly.app

# Feature flags (evaluation defaults)
FEATURE_BANK_SYNC=false
FEATURE_MULTI_CURRENCY=false

# Mail — optional; defaults to the "log" driver (no delivery)
MAIL_MAILER=log
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=noreply@gaeld.tachly.app

# First boot runs `php artisan gaeld:install --no-interaction` (idempotent).
GAELD_AUTO_INSTALL=true
